{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "request": "launch",
      "name": "Client",
      "presentation": {
        "group": "Mod Development - genesis",
        "order": 0
      },
      "projectName": "genesis",
      "mainClass": "net.neoforged.devlaunch.Main",
      "args": [
        "@/media/Software/programming/java/modpack/shipwrights/genesis/build/moddev/clientRunProgramArgs.txt"
      ],
      "vmArgs": [
        "@/media/Software/programming/java/modpack/shipwrights/genesis/build/moddev/clientRunVmArgs.txt",
        "-Dfml.modFolders\u003dtestproject%%/media/Software/programming/java/modpack/shipwrights/genesis/bin/main"
      ],
      "cwd": "${workspaceFolder}/run",
      "env": {
        "MOD_CLASSES": "testproject%%/media/Software/programming/java/modpack/shipwrights/genesis/bin/main"
      },
      "console": "internalConsole",
      "shortenCommandLine": "none"
    },
